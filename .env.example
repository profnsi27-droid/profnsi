# ===== PROFNSI — Variables d'environnement (à configurer sur Vercel) =====

# --- Base de données (PostgreSQL) ---
# Vercel Postgres / Neon / Supabase : collez ici la chaîne de connexion fournie.
# Ex : postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/profnsi?sslmode=require

# --- Identifiants professeur unique ---
# Définissez VOS identifiants définitifs (le compte par défaut est profnsi/nsi2025
# tant que ces variables ne sont pas renseignées — changez-les impérativement).
PROFNSI_USERNAME=profnsi
PROFNSI_PASSWORD=changez-moi-avec-un-mot-de-passe-fort
PROFNSI_SESSION_SECRET=une-chaine-aleatoire-longue-et-secrète

# --- Stockage des fichiers (Vercel Blob) ---
# Créez un Blob Store dans Vercel → Settings → Storage, puis copiez le token.
BLOB_READ_WRITE_TOKEN=

# --- Agent IA de correction ---
# Option A (recommandée, gratuite, idéale Vercel) : Google Gemini.
#   Obtenez une clé gratuite sur https://aistudio.google.com/
GEMINI_API_KEY=
# Option B : si GEMINI_API_KEY n'est pas défini, l'application utilise
#   automatiquement le SDK z-ai-web-dev-sdk (modèles GLM) — utile en dev local.

# --- Envoi des copies corrigées par e-mail (SMTP) ---
# Sans SMTP configuré, les PDF sont générés et téléchargeables (mode simulé).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
